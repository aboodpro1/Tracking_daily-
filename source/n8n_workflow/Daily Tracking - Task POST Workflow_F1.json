    {
      "parameters": {
        "jsCode": "// 1. Extract payload\nconst body = $json.body || $json;\n\n// 2. Resolve Page ID / Task ID\nconst pageId = body.taskId || body.id || body.data?.taskId || body.data?.id;\nconst rawStatus = body.status || body.status_text || body.data?.status || '';\n\nif (!pageId) {\n  return {\n    json: {\n      isError: true,\n      statusCode: 400,\n      error: {\n        message: 'معرف المهمة (Task ID) مطلوب لتحديث الحالة',\n        code: 'MISSING_TASK_ID',\n        field: 'taskId'\n      }\n    }\n  };\n}\n\n// 3. Normalization to Arabic Notion status\nconst statusMap = {\n  pending: 'قيد الانتظار',\n  progress: 'قيد التنفيذ',\n  completed: 'مكتملة',\n  'not started': 'قيد الانتظار',\n  'in progress': 'قيد التنفيذ',\n  done: 'مكتملة',\n  'قيد الانتظار': 'قيد الانتظار',\n  'قيد التنفيذ': 'قيد التنفيذ',\n  'مكتملة': 'مكتملة'\n};\n\nconst normalizedStatus = statusMap[String(rawStatus).toLowerCase()] || rawStatus || 'قيد الانتظار';\n\nreturn {\n  json: {\n    isError: false,\n    databaseId: '3dc6fd16-45b0-8072-9e75-fb87ba35ed28',\n    pageId: pageId,\n    taskId: pageId,\n    status: normalizedStatus,\n    statusKey: body.statusKey || 'pending',\n    updatedAt: body.updated_at || new Date().toISOString()\n  }\n};"
      },
