    {
      "parameters": {
        "jsCode": "// 1. Extract request payload\nconst body = $json.body || $json;\nconst data = body.data || body;\n\n// 2. Validate mandatory fields\nconst title = String(data.title || '').trim();\nconst description = String(data.description || '').trim();\nconst authenticatedUserId = String(data.userId || data['user ID'] || data.id || '').trim();\nconst userEmail = String(data.userEmail || data.email || '').trim().toLowerCase();\n\nif (!title) {\n  return {\n    json: {\n      isError: true,\n      statusCode: 400,\n      error: {\n        message: 'عنوان المهمة مطلوب',\n        code: 'MISSING_TITLE',\n        field: 'title'\n      }\n    }\n  };\n}\n\nif (!description) {\n  return {\n    json: {\n      isError: true,\n      statusCode: 400,\n      error: {\n        message: 'وصف المهمة مطلوب',\n        code: 'MISSING_DESCRIPTION',\n        field: 'description'\n      }\n    }\n  };\n}\n\nif (!authenticatedUserId && !userEmail) {\n  return {\n    json: {\n      isError: true,\n      statusCode: 401,\n      error: {\n        message: 'معرف المستخدم غير موجود، يرجى تسجيل الدخول أولاً',\n        code: 'UNAUTHENTICATED_USER',\n        field: 'user ID'\n      }\n    }\n  };\n}\n\n// 3. Normalization maps for Notion schema\nconst categoryMap = {\n  religious: 'دينية',\n  body: 'جسم',\n  work: 'شغل',\n  study: 'دراسة',\n  'دينية': 'دينية',\n  'جسم': 'جسم',\n  'شغل': 'شغل',\n  'دراسة': 'دراسة'\n};\n\nconst priorityMap = {\n  important: 'مهمة',\n  normal: 'عادية',\n  high: 'مهمة',\n  urgent: 'مهمة',\n  'مهمة': 'مهمة',\n  'عادية': 'عادية'\n};\n\nconst durationMap = {\n  under_hour: 'أقل من ساعة',\n  one_hour: 'ساعة',\n  two_hours: 'ساعتان',\n  'أقل من ساعة': 'أقل من ساعة',\n  'ساعة': 'ساعة',\n  'ساعتان': 'ساعتان'\n};\n\nconst today = new Date().toISOString().split('T')[0];\nconst category = categoryMap[data.category] || data.category || 'شغل';\nconst priority = priorityMap[data.priority] || data.priority || 'عادية';\nconst duration = durationMap[data.duration] || data.duration || 'أقل من ساعة';\nconst status = data.status || 'قيد الانتظار';\nconst date = data.date || today;\n\nreturn {\n  json: {\n    isError: false,\n    databaseId: '3dc6fd16-45b0-8072-9e75-fb87ba35ed28',\n    title: title,\n    description: description,\n    category: category,\n    priority: priority,\n    duration: duration,\n    status: status,\n    date: date,\n    userId: authenticatedUserId,\n    'user ID': authenticatedUserId,\n    userEmail: userEmail,\n    userName: data.userName || data.name || '',\n    userRole: data.userRole || data.role || 'member'\n  }\n};"
      },
