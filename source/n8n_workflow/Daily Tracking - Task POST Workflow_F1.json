      "parameters": {
        "jsCode": "// 1. Generate unique Task ID via JavaScript\nconst timestamp = Date.now();\nconst randomPart = Math.random().toString(36).substring(2, 8).toUpperCase();\nconst generatedTaskId = `TASK-${timestamp}-${randomPart}`;\n\n// 2. Retrieve user and task context\nconst inputUserRecord = $input.first()?.json || {};\nconst taskContext = $('Validate and Prepare Add Task').first().json;\nconst userPageId = inputUserRecord.id || '';\n\nreturn {\n  json: {\n    ...taskContext,\n    userPageId: userPageId,\n    'user ID': taskContext.userId,\n    userId: taskContext.userId,\n    ID_task: generatedTaskId\n  }\n};"
