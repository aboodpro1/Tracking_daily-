        "jsCode": "// Extract Notion or general execution error\nconst errorData = $json.error || $json;\n\nreturn {\n  json: {\n    isError: true,\n    statusCode: 500,\n    error: {\n      operation: 'add_task',\n      message: errorData.message || 'فشل حفظ المهمة في Notion، يرجى التحقق من الاتصال',\n      details: errorData.description || errorData.name || 'Notion API failure'\n    }\n  }\n};"
