    {
      "parameters": {
        "jsCode": "// 1. Extract verified Notion record\nconst notionUser = $json;\nconst props = notionUser.properties || {};\n\nlet storedEmail = props.Email?.email || notionUser.property_Email || '';\nlet storedName = props.Name?.title?.[0]?.plain_text || notionUser.property_Name || '';\nlet storedRole = props.Role?.select?.name || notionUser.property_Role || 'Member';\nlet storedStatus = props.Status?.select?.name || notionUser.property_Status || 'Active';\nlet storedUserId = props['User ID']?.rich_text?.[0]?.plain_text || notionUser['property_User ID'] || '';\n\nif (!storedEmail || storedStatus !== 'Active') {\n  return {\n    json: {\n      process: 'error',\n      valid: false,\n      message: 'الجلسة غير صالحة أو الحساب غير مفعّل.'\n    }\n  };\n}\n\nreturn {\n  json: {\n    process: 'done',\n    valid: true,\n    status: 'success',\n    user: {\n      id: storedUserId,\n      name: storedName,\n      email: storedEmail,\n      role: storedRole,\n      status: storedStatus\n    }\n  }\n};"
