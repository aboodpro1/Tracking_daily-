    {
      "parameters": {
        "jsCode": "// 1. Retrieve input credentials and Notion query result\nconst signinData = $('Validate and Prepare Sign In').item.json;\nconst notionUser = $json;\n\n// 2. Extract properties from Notion record\nconst props = notionUser.properties || {};\n\n// تم تصحيح حالة الأحرف (حروف صغيرة) لتتطابق مع مخرجات n8n\nlet storedEmail = props.Email?.email || notionUser.property_email || '';\nlet storedPassword = props.Password?.rich_text?.[0]?.plain_text || notionUser.property_password || '';\nlet storedName = props.Name?.title?.[0]?.plain_text || notionUser.name || notionUser.property_name || '';\nlet storedRole = props.Role?.select?.name || notionUser.property_role || 'Member';\nlet storedStatus = props.Status?.select?.name || notionUser.property_status || 'Active';\nlet storedUserId = props['User ID']?.rich_text?.[0]?.plain_text || notionUser.property_user_id || notionUser.id || '';\n\n// 3. Authenticate\nif (!storedEmail || storedEmail.toLowerCase() !== signinData.email.toLowerCase()) {\n  return {\n    json: {\n      process: 'error',\n      status: 'error',\n      message: 'البريد الإلكتروني غير مسجل، يرجى إنشاء حساب جديد.'\n    }\n  };\n}\n\nif (storedStatus !== 'Active') {\n  return {\n    json: {\n      process: 'error',\n      status: 'error',\n      message: 'الحساب غير مفعّل أو تم إيقافه، يرجى مراجعة إدارة النظام.'\n    }\n  };\n}\n\nif (storedPassword !== signinData.password) {\n  return {\n    json: {\n      process: 'error',\n      status: 'error',\n      message: 'كلمة المرور غير صحيحة، يرجى المحاولة مرة أخرى.'\n    }\n  };\n}\n\n// 4. Authentication success: generate token & payload\nconst token = 'token_' + Date.now() + '_' + Math.random().toString(36).substring(2, 9);\n\nreturn {\n  json: {\n    process: 'done',\n    status: 'success',\n    message: 'تم تسجيل الدخول بنجاح',\n    token: token,\n    user: {\n      id: storedUserId,\n      name: storedName,\n      email: storedEmail,\n      role: storedRole,\n      status: storedStatus\n    }\n  }\n};"
      },
