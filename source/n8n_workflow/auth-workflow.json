      "parameters": {
        "jsCode": "// 1. Extract session parameters\nconst body = $json.body || $json;\nconst query = $json.query || {};\n\nconst token = body.token || query.token || '';\nconst email = String(body.email || query.email || '').trim().toLowerCase();\n\nif (!token || !email) {\n  throw new Error('Token and email are required for session verification');\n}\n\nreturn {\n  json: {\n    databaseId: '3dc6fd16-45b0-80ff-8435-c255ed191886',\n    token: token,\n    email: email\n  }\n};"
