      "parameters": {
        "jsCode": "// 1. Extract payload\nconst body = $json.body || $json;\nconst data = body.data || body;\n\n// 2. Validate mandatory registration fields\nconst name = String(data.name || '').trim();\nconst email = String(data.email || '').trim().toLowerCase();\nconst password = String(data.password || '').trim();\n\nif (!name) {\n  throw new Error('Name is required');\n}\nif (!email || !email.includes('@')) {\n  throw new Error('Valid email is required');\n}\nif (!password || password.length < 8) {\n  throw new Error('Password must be at least 8 characters');\n}\n\n// 3. Normalize role\nconst roleMap = {\n  admin: 'Admin',\n  lead: 'Lead',\n  member: 'Member',\n  Admin: 'Admin',\n  Lead: 'Lead',\n  Member: 'Member'\n};\nconst role = roleMap[data.role] || 'Member';\nconst userId = data.userId || 'usr_' + Math.random().toString(36).substring(2, 11);\n\nreturn {\n  json: {\n    databaseId: '3dc6fd16-45b0-80ff-8435-c255ed191886',\n    name: name,\n    email: email,\n    password: password,\n    role: role,\n    status: 'Active',\n    userId: userId,\n    createdAt: new Date().toISOString()\n  }\n};"
      },
